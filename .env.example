# ==============================================================================
# PyAssess — Complete Platform Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# Express API Environment (apps/api)
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=4000
API_BASE_URL=http://localhost:4000

# PostgreSQL (Supabase or direct connection)
# Prisma connection URL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/pyassess?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/pyassess?schema=public"

# Supabase Auth Integration
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_PUBLISHABLE_KEY="your-anon-or-publishable-key"
SUPABASE_SECRET_KEY="your-supabase-service-role-key"

# Initial Administrator Google Email (auto-seeded on first auth if matches)
INITIAL_ADMIN_EMAIL="admin@astu.edu.et"

# Internal Python Execution Worker Configuration
PYTHON_RUNNER_URL="http://localhost:5001"
PYTHON_RUNNER_SECRET="generate-a-strong-random-shared-secret-for-internal-hmac"

# Frontend Origin for CORS
CORS_ORIGIN="http://localhost:3000"

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=120

# ------------------------------------------------------------------------------
# Next.js Web Frontend Environment (apps/web)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_API_BASE_URL="http://localhost:4000/api/v1"
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="your-anon-or-publishable-key"

# ------------------------------------------------------------------------------
# Isolated Python Runner Environment (services/python-runner)
# ------------------------------------------------------------------------------
RUNNER_PORT=5001
RUNNER_SECRET="generate-a-strong-random-shared-secret-for-internal-hmac"
RUNNER_EXEC_TIMEOUT_MS=3000
RUNNER_MAX_MEMORY_MB=128
RUNNER_MAX_OUTPUT_BYTES=65536
